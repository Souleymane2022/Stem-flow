# Copiez ce fichier en `.env` puis renseignez les valeurs de votre projet Supabase.
# Sur Vercel, déclarez les mêmes variables dans Settings > Environment Variables.

# --- Public : exposé au navigateur (inclus dans le bundle client) ---
VITE_SUPABASE_URL="https://<votre-ref>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
VITE_SUPABASE_PROJECT_ID="<votre-ref>"

# Mêmes valeurs, lues côté serveur (SSR) quand import.meta.env n'est pas disponible.
SUPABASE_URL="https://<votre-ref>.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_PROJECT_ID="<votre-ref>"

# --- Secret : serveur uniquement, ne JAMAIS committer ni préfixer par VITE_ ---
# Contourne les politiques RLS. Requis par src/integrations/supabase/client.server.ts.
SUPABASE_SERVICE_ROLE_KEY=""

# Passerelle IA Lovable, utilisée par la génération de questions de compétition
# (src/lib/competitions.functions.ts). Sans elle, cette fonction renvoie
# « Clé IA manquante » ; le reste de l'application fonctionne normalement.
LOVABLE_API_KEY=""

# --- Facultatif ---
# Racine absolue du site, utilisée pour l'aperçu partagé sur les réseaux
# (og:image). Sans elle, l'aperçu utilise un chemin relatif, que certains
# robots refusent.
VITE_SITE_URL="https://<votre-projet>.vercel.app"
